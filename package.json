{
  "name": "grattouille",
  "private": true,
  "version": "1.0.0",
  "description": "Grattouille — jeu de fiction de tickets à gratter. Aucun argent réel.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "serve": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "zip": "node scripts/make-zip.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@netlify/functions": "^6.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
